SELECT (SELECT array_agg(random()::real)::vector FROM generate_series(1,128))
FROM generate_series(1,20);
-- Verify nonzero buffer reads
SELECT sum(buffer_read_pages) > 0 AS has_buffer_reads FROM hnsw_io_layer_stats();
